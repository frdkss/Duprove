{
  "name": "duprove",
  "version": "1.0.0",
  "private": true,
  "description": "Локальный анализ дубликатов файлов",
  "author": "frdkss",
  "license": "GPL-3.0-only",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run icons && tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "icons": "node scripts/build-icons.mjs",
    "native:configure": "cmake -S native -B build/native",
    "native:build": "cmake --build build/native --config Release",
    "start": "node scripts/run-electron.mjs .",
    "test": "node scripts/build-tests.mjs && node --test tests/*.test.cjs",
    "test:native": "python tests/test_analyzer.py",
    "package": "npm run build && electron-builder --publish never",
    "test:backend": "python -m unittest discover -s tests -p test_contract.py",
    "test:ui": "node scripts/build-tests.mjs && node --check tests/ui-smoke.cjs && node scripts/run-electron.mjs tests/ui-smoke.cjs",
    "test:startup": "node scripts/run-electron.mjs tests/app-startup.cjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.7.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "ru.duprove.desktop",
    "productName": "Duprove",
    "icon": "public/logo.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "docs/statistics-notice.txt",
        "to": "statistics-notice.txt"
      },
      {
        "from": "build/native/bin",
        "to": "analyzer",
        "filter": [
          "duprove-analyzer*"
        ]
      }
    ],
    "artifactName": "Duprove-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "public/logo.ico",
      "target": [
        "nsis"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "include": "installer/installer.nsh",
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "frdkss"
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "publish": [
      {
        "provider": "github",
        "owner": "frdkss",
        "repo": "Duprove"
      }
    ]
  }
}
