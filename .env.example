# Local Docker debug server. npm run server:dev creates/updates .env.
DUPROVE_DEV_PROJECT=duprove-debug
DUPROVE_LISTEN=127.0.0.1:8443
DUPROVE_TLS_DIR=.verification/server-dev/tls
DUPROVE_CA_FILE=.verification/server-dev/tls/fullchain.pem
DUPROVE_REPORT_URL=https://127.0.0.1:8443/v1/reports
# Actual HTTPS proxy IP, discovered after Docker starts (never guessed).
DUPROVE_CONTAINER_IP=
